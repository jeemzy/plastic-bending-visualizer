{
  "name": "plastic-bending-visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/notices.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/model.test.ts tests/geometry.test.ts && npm run test:components && npm run test:interaction",
    "typecheck": "tsc -b",
    "test:components": "esbuild tests/fallback.test.tsx --bundle --platform=node --format=esm --packages=external --jsx=automatic --outfile=verification/fallback.test.mjs && node --test verification/fallback.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "preview:single": "node scripts/notices.mjs && node scripts/standalone.mjs",
    "deploy": "node scripts/deploy.mjs",
    "format": "prettier --write src tests scripts *.json *.ts *.html .github/workflows/pages.yml docs/*.md README.md",
    "test:interaction": "esbuild tests/interaction.test.tsx --bundle --platform=node --format=esm --packages=external --jsx=automatic --define:import.meta.env.VITE_SOURCE_URL=undefined --outfile=verification/interaction.test.mjs && node --test verification/interaction.test.mjs",
    "test:static": "node tests/static.mjs",
    "test:standalone": "npm run preview:single && node tests/standalone.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
